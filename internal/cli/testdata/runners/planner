#!/usr/bin/env bash
set -u
state=${WD_FAKE_STATE:?WD_FAKE_STATE needed}
case "$1" in
  run)
    n=$(cat "$state/planner-n" 2>/dev/null || echo 0)
    n=$((n + 1))
    echo "$n" > "$state/planner-n"
    printf 'session=planner-s%05x\n' "$n"
    ;;
  export)
    # A test makes the planner ask instead of plan by creating $state/planner-asks.
    if [ -f "$state/planner-asks" ]; then
      echo 'The request stops mid-sentence.'
      echo 'ASK: What should change in the new worktree?'
      exit 0
    fi
    # A test gives the planner its own reply in $state/planner-reply.
    if [ -f "$state/planner-reply" ]; then
      cat "$state/planner-reply"
      exit 0
    fi
    echo 'NAME: Config parsing and schema'
    echo 'FINISH: complete PR | from: taste'
    echo '- The config is read into one checked shape'
    echo '  done when: a bad config is refused naming the field'
    echo '- The decision is kept in the schema'
    echo '  done when: the schema holds the decision'
    ;;
  stop) echo "planner $2" >> "$WD_FAKE_STATE/stopped"; echo stopped;;
  status) echo 'state: waiting';;
  send) echo ok;;
  models) echo 'planner/m1';;
  *) echo "unhandled planner $*" >&2; exit 1;;
esac