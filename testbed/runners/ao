#!/usr/bin/env bash
set -u
case "$1 $2" in
  "spawn --name")
    n=$(( $(cat "$WD_FAKE_STATE/ao-n" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$WD_FAKE_STATE/ao-n"
    sid="ao-ses-s$(printf '%03x' "$n")"
    echo "$sid" > "$WD_FAKE_STATE/ao-sid"
    echo "spawned session $sid (idle) [prompt ok]";;
  "session get")
    echo "{\"session\":{\"activity\":{\"state\":\"idle\"},\"isTerminated\":false}}";;
  "send --session")
    echo "sent";;
  *) echo "unhandled ao $*" >&2; exit 1;;
esac